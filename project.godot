; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HorrorGame"
config/description="3D psychological horror meta-game. The player is a game tester; the game under test starts to test the player back."
config/version="0.1.0"
run/main_scene="res://ui/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameManager="*res://systems/game_manager/game_manager.gd"
StoryFlags="*res://systems/story/story_flags.gd"
Settings="*res://systems/settings/settings_system.gd"
SaveSystem="*res://systems/save/save_system.gd"
AudioManager="*res://systems/audio/audio_manager.gd"
BugSystem="*res://systems/bug_system/bug_system.gd"
TaskSystem="*res://systems/task_system/task_system.gd"
ReportSystem="*res://systems/report_system/report_system.gd"
InteractionSystem="*res://systems/interaction/interaction_system.gd"
DialogueSystem="*res://systems/dialogue/dialogue_system.gd"
PhotoSystem="*res://systems/photo/photo_system.gd"
CameraSystem="*res://systems/photo/camera_system.gd"
MinigameSystem="*res://systems/minigame/minigame_system.gd"
ComputerSystem="*res://systems/computer/computer_system.gd"
HorrorSystem="*res://systems/horror/horror_system.gd"
StorySystem="*res://systems/story/story_system.gd"
CursorWatcher="*res://systems/story/cursor_watcher.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0

