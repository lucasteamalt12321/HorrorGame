[resource]
script = ExtResource("1_res")
id = "mail_01_assignment"
kind = 0
sender_name = "Менеджер проекта"
sender_address = "manager@ninecircles.local"
subject = "Назначение · L1_GARDEN"
body = "QA-07, добрый день.

Первое назначение на сегодня: сектор сада, L1_GARDEN.
Дойдите до конца уровня и зафиксируйте отклонения.

Напоминаю: снимок без отчёта не считается работой.
Отчёт оформляется в баг-трекере, поле «Комментарий» обязательно.
Если снимок невозможен — вложите журнал.

Спасибо.
"
chapter = 1
requires_task_id = "T01_FIRST_CONTACT"
