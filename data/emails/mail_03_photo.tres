[resource]
script = ExtResource("1_res")
id = "mail_03_photo"
kind = 0
sender_name = "QA-Отдел"
sender_address = "qa-dept@ninecircles.local"
subject = "Проверка архива снимков"
body = "QA-07.

Перед сдачей смены требуется подтвердить, что снимки сохраняются корректно.
Откройте архив и просмотрите последние кадры.

Учтите: снимки не записываются на диск. Политика хранения — только память
до конца смены. Если снимок нужно предъявить — предъявляйте сразу, из архива.

Второе: если текст в игре не совпадает с исходниками — приложите оба.
Расхождение фиксируется как отдельный отчёт, не как часть другого.
"
chapter = 3
requires_task_id = "T06_ARCHIVE"
