[gd_resource type="Resource" script_class="TaskResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/resources/task_resource.gd" id="1_res"]

[resource]
script = ExtResource("1_res")
id = "T01_FIRST_CONTACT"
title = "Первый контакт с багом"
description = "Руководитель просит проверить сектор сада (L1_GARDEN). Обычная рутина: дойти до конца уровня и зафиксировать всё, что выглядит неправильно.
Снимок и отчёт — обязательны. Отчёт принимает баг-трекер, а не онлайн-форма."
brief = "L1_GARDEN: дойти до финиша и закрыть хотя бы один баг"
chapter = 1
order = 1
conditions = Array[Dictionary]([{"amount": 1, "kind": 0}])
required_bug_ids = PackedStringArray("BUG_NPC_WALL")
required_flag = &""
next_task_id = "T02_FINISH_GARDEN"
reply_email_id = "mail_01_reply"
sets_tension = 1
hint = "Охранник у стены на развилке. Нажмите ЛКМ, когда аномалия в кадре, затем отчёт в баг-трекере."
